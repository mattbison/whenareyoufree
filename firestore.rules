rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Target the specific subcollection where availability is stored
    match /groups/{groupId}/availability/{userId} {
      // Allow anyone to read anyone else's availability within the same group.
      allow read: if true;

      // A user can only create, update, or delete their own availability document.
      // The {userId} in the path must match the ID of the user making the request.
      allow write: if request.auth.uid == userId;
    }

    // Optional per-date plan notes shown under "Best Dates to Meet".
    // Anyone with the group link can read; any signed-in user can edit.
    match /groups/{groupId}/eventNotes/{dateKey} {
      allow read: if true;
      allow delete: if request.auth != null;
      allow create, update: if request.auth != null
        && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['text', 'updatedBy', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 140;
    }
  }
}
